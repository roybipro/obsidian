/* ==========================================================================
   Notion-style theme for Bipro's vault
   Settings → Appearance → CSS snippets → "notion-style" (toggle on)
   Global layer: typography, tables, tags, tasks, callouts, inputs.
   Dashboard layer (pages with cssclasses: nt-page / nt-cover): cover,
   stat tiles, pills, progress bars, cards, nav grid.
   ========================================================================== */

/* ---------- Palette (Notion's own colours) ---------- */
body {
  --nt-font: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI Variable Display", "Segoe UI", Helvetica, "Apple Color Emoji", Arial, sans-serif;
  --nt-radius: 6px;
  --nt-radius-lg: 10px;
}
.theme-light {
  --nt-bg: #ffffff;  --nt-bg-soft: #f7f6f3;  --nt-bg-hover: rgba(55,53,47,.06);
  --nt-text: #37352f; --nt-muted: rgba(55,53,47,.65); --nt-faint: rgba(55,53,47,.45);
  --nt-border: rgba(55,53,47,.12); --nt-shadow: rgba(15,15,15,.06) 0 0 0 1px, rgba(15,15,15,.06) 0 2px 6px;
  --nt-gray-bg: #f1f1ef;   --nt-gray: #787774;
  --nt-brown-bg: #f4eeee;  --nt-brown: #9f6b53;
  --nt-orange-bg: #fbecdd; --nt-orange: #d9730d;
  --nt-yellow-bg: #fbf3db; --nt-yellow: #cb912f;
  --nt-green-bg: #edf3ec;  --nt-green: #448361;
  --nt-blue-bg: #e7f3f8;   --nt-blue: #337ea9;
  --nt-purple-bg: #f6f3f9; --nt-purple: #9065b0;
  --nt-pink-bg: #faf1f5;   --nt-pink: #c14c8a;
  --nt-red-bg: #fdebec;    --nt-red: #d44c47;
}
.theme-dark {
  --nt-bg: #191919;  --nt-bg-soft: #202020;  --nt-bg-hover: rgba(255,255,255,.055);
  --nt-text: rgba(255,255,255,.81); --nt-muted: rgba(255,255,255,.55); --nt-faint: rgba(255,255,255,.35);
  --nt-border: rgba(255,255,255,.094); --nt-shadow: rgba(15,15,15,.2) 0 0 0 1px, rgba(15,15,15,.3) 0 2px 8px;
  --nt-gray-bg: #2f2f2f;   --nt-gray: #9b9b9b;
  --nt-brown-bg: #4a3228;  --nt-brown: #ba856f;
  --nt-orange-bg: #5c3b23; --nt-orange: #c77d48;
  --nt-yellow-bg: #564328; --nt-yellow: #ca9849;
  --nt-green-bg: #243d30;  --nt-green: #529e72;
  --nt-blue-bg: #143a4e;   --nt-blue: #5e87c9;
  --nt-purple-bg: #3c2d49; --nt-purple: #9d68d3;
  --nt-pink-bg: #4e2c3c;   --nt-pink: #d15796;
  --nt-red-bg: #522e2a;    --nt-red: #df5452;
  --background-primary: #191919;
  --background-secondary: #202020;
}

/* ---------- Global typography ---------- */
body {
  --font-text-theme: var(--nt-font);
  --font-interface-theme: var(--nt-font);
  --font-text-size: 16px;
  --line-height-normal: 1.6;
  --h1-size: 1.875em; --h2-size: 1.5em; --h3-size: 1.25em; --h4-size: 1.1em;
  --h1-weight: 700; --h2-weight: 600; --h3-weight: 600; --h4-weight: 600;
  --inline-title-size: 2.5em; --inline-title-weight: 700;
  --link-decoration: none;
  --link-external-decoration: none;
}
.markdown-rendered h1, .markdown-rendered h2, .markdown-rendered h3,
.cm-header-1, .cm-header-2, .cm-header-3 { letter-spacing: -0.01em; }
.markdown-rendered h2 { margin-top: 1.6em; padding-bottom: .25em; }
.markdown-rendered h3 { margin-top: 1.3em; }
.markdown-rendered hr { border-color: var(--nt-border); }

/* Links look like Notion (underlined softly) */
.markdown-rendered a.internal-link,
.cm-hmd-internal-link .cm-underline {
  color: inherit; text-decoration: underline; text-decoration-color: var(--nt-faint);
  text-underline-offset: 3px; font-weight: 500;
}
.markdown-rendered a.internal-link:hover { text-decoration-color: currentColor; }

/* ---------- Tables (incl. Dataview) ---------- */
.markdown-rendered table, .table-view-table {
  border-collapse: collapse; width: 100%; font-size: .92em;
}
.markdown-rendered th, .table-view-table th {
  font-weight: 500; color: var(--nt-muted); text-align: left;
  background: transparent !important; border: none !important;
  border-bottom: 1px solid var(--nt-border) !important; padding: 6px 10px !important;
}
.markdown-rendered td, .table-view-table td {
  border: none !important; border-bottom: 1px solid var(--nt-border) !important;
  padding: 7px 10px !important; vertical-align: middle;
}
.markdown-rendered tr:hover td, .table-view-table tr:hover td { background: var(--nt-bg-hover); }
.markdown-rendered tbody tr:nth-child(even) { background: transparent; }
.dataview.table-view-table thead .dataview.small-text { display: none; } /* hide row counts */
.table-view-table > thead > tr > th { font-size: .82em; text-transform: none; }

/* ---------- Tags as Notion pills ---------- */
.markdown-rendered a.tag, .cm-hashtag {
  background: var(--nt-gray-bg); color: var(--nt-text); border: none;
  border-radius: 4px; padding: 1px 7px; font-size: .82em; font-weight: 500; text-decoration: none;
}
.cm-hashtag-begin { border-radius: 4px 0 0 4px; padding-right: 0; }
.cm-hashtag-end { border-radius: 0 4px 4px 0; padding-left: 0; }

/* ---------- Tasks ---------- */
input[type=checkbox].task-list-item-checkbox {
  width: 16px; height: 16px; border-radius: 4px; border: 1.5px solid var(--nt-faint);
}
input[type=checkbox].task-list-item-checkbox:checked { background-color: var(--nt-blue); border-color: var(--nt-blue); }
.markdown-rendered .task-list-item.is-checked, .HyperMD-task-line[data-task="x"] {
  color: var(--nt-faint); text-decoration: line-through; text-decoration-color: var(--nt-faint);
}
.markdown-rendered ul.contains-task-list > li { padding: 2px 0; }
/* Dataview inline fields like [due:: …] become small date chips */
.dataview.inline-field { font-size: .8em; }
.dataview.inline-field-key { background: var(--nt-gray-bg); color: var(--nt-muted); border-radius: 4px 0 0 4px; padding: 1px 6px; }
.dataview.inline-field-value { background: var(--nt-red-bg); color: var(--nt-red); border-radius: 0 4px 4px 0; padding: 1px 6px; font-family: var(--nt-font); }

/* ---------- Callouts as soft Notion blocks ---------- */
.callout {
  --callout-padding: 14px 16px; border: none; border-radius: var(--nt-radius);
  background: var(--nt-bg-soft) !important; mix-blend-mode: normal;
}
.callout-title { color: var(--nt-text); font-weight: 600; }
.callout-icon { color: var(--callout-color, var(--nt-muted)); }

/* Blockquotes: Notion style left bar */
.markdown-rendered blockquote { border-left: 3px solid var(--nt-text); padding: 2px 14px; color: var(--nt-text); background: transparent; }

/* ---------- Inputs & buttons (Command Center planner) ---------- */
.markdown-rendered input[type=text] {
  background: var(--nt-bg-soft) !important; border: 1px solid var(--nt-border) !important;
  border-radius: var(--nt-radius) !important; padding: 7px 10px !important; color: var(--nt-text);
  box-shadow: none !important; font-family: var(--nt-font);
}
.markdown-rendered input[type=text]:focus { border-color: var(--nt-blue) !important; box-shadow: 0 0 0 2px var(--nt-blue-bg) !important; }
.markdown-rendered button {
  background: var(--nt-bg-soft); color: var(--nt-text); border: 1px solid var(--nt-border);
  border-radius: var(--nt-radius); box-shadow: none; font-weight: 500; cursor: pointer;
}
.markdown-rendered button:hover { background: var(--nt-bg-hover); }
.markdown-rendered progress { height: 6px; border-radius: 3px; overflow: hidden; accent-color: var(--nt-blue); }

/* ---------- Properties panel ---------- */
.metadata-container { --metadata-label-text-color: var(--nt-muted); border-bottom: 1px solid var(--nt-border); padding-bottom: 8px; }
.metadata-property:hover { background: var(--nt-bg-hover); border-radius: 4px; }

/* ==========================================================================
   Dashboard layer
   ========================================================================== */
.nt-page.markdown-preview-view, .nt-page .markdown-preview-view,
.nt-page.markdown-source-view, .nt-page .markdown-source-view { --file-line-width: 1080px; }

/* Cover banner (like a Notion page cover) */
.nt-cover .markdown-preview-sizer::before,
.nt-cover.markdown-source-view .cm-sizer::before {
  content: ""; display: block; height: 170px; margin: 0 0 6px; border-radius: var(--nt-radius-lg);
  background:
    radial-gradient(circle at 15% 30%, rgba(255,255,255,.25), transparent 40%),
    linear-gradient(120deg, #0f4c75 0%, #3282b8 35%, #6c5b7b 70%, #c06c84 100%);
}
.nt-cover .inline-title { margin-top: 4px; }

/* Hide raw code if Dataview is still loading */
.nt-page .block-language-dataviewjs:empty { min-height: 20px; }

/* Section label (small gray caps above blocks) */
.nt-label { font-size: .78em; color: var(--nt-muted); font-weight: 600; letter-spacing: .02em; margin: 2px 0 6px; }

/* Stat tiles */
.nt-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin: 6px 0 14px; }
.nt-tile {
  background: var(--nt-bg-soft); border: 1px solid var(--nt-border); border-radius: var(--nt-radius-lg);
  padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; min-height: 86px;
}
.nt-tile .nt-tile-icon { font-size: 1.05em; }
.nt-tile .nt-tile-value { font-size: 1.6em; font-weight: 700; line-height: 1.15; color: var(--nt-text); }
.nt-tile .nt-tile-label { font-size: .8em; color: var(--nt-muted); }
.nt-tile .nt-bar { margin-top: 6px; }

/* Pills */
.nt-pill {
  display: inline-block; padding: 0 8px; border-radius: 4px; font-size: .82em; font-weight: 500;
  line-height: 1.6; white-space: nowrap; background: var(--nt-gray-bg); color: var(--nt-text);
}
.nt-pill::before { content: "●"; font-size: .7em; margin-right: 5px; vertical-align: 1px; }
.nt-gray   { background: var(--nt-gray-bg); }   .nt-gray::before   { color: var(--nt-gray); }
.nt-brown  { background: var(--nt-brown-bg); }  .nt-brown::before  { color: var(--nt-brown); }
.nt-orange { background: var(--nt-orange-bg); } .nt-orange::before { color: var(--nt-orange); }
.nt-yellow { background: var(--nt-yellow-bg); } .nt-yellow::before { color: var(--nt-yellow); }
.nt-green  { background: var(--nt-green-bg); }  .nt-green::before  { color: var(--nt-green); }
.nt-blue   { background: var(--nt-blue-bg); }   .nt-blue::before   { color: var(--nt-blue); }
.nt-purple { background: var(--nt-purple-bg); } .nt-purple::before { color: var(--nt-purple); }
.nt-pink   { background: var(--nt-pink-bg); }   .nt-pink::before   { color: var(--nt-pink); }
.nt-red    { background: var(--nt-red-bg); }    .nt-red::before    { color: var(--nt-red); }
.nt-pill.nt-plain::before { content: none; }

/* Progress bar */
.nt-bar { display: inline-flex; align-items: center; gap: 8px; width: 100%; max-width: 220px; vertical-align: middle; }
.nt-bar .nt-track { flex: 1; height: 6px; border-radius: 3px; background: var(--nt-gray-bg); overflow: hidden; min-width: 60px; }
.nt-bar .nt-fill { display: block; height: 100%; border-radius: 3px; background: var(--nt-blue); }
.nt-bar .nt-fill.nt-done { background: var(--nt-green); }
.nt-bar .nt-pct { font-size: .78em; color: var(--nt-muted); min-width: 34px; text-align: right; }
.nt-muted { color: var(--nt-muted); font-size: .88em; }

/* Gallery cards */
.nt-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; margin: 6px 0 16px; }
.nt-card {
  background: var(--nt-bg-soft); border: 1px solid var(--nt-border); border-radius: var(--nt-radius-lg);
  padding: 0; overflow: hidden; display: flex; flex-direction: column; transition: background .12s, box-shadow .12s;
}
.nt-card:hover { background: var(--nt-bg-hover); box-shadow: var(--nt-shadow); }
.nt-card .nt-card-top { height: 6px; background: var(--nt-blue); }
.nt-card .nt-card-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 8px; }
.nt-card .nt-card-title { font-weight: 600; line-height: 1.35; }
.nt-card .nt-card-title a { text-decoration: none !important; color: var(--nt-text) !important; }
.nt-card .nt-card-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }

/* Navigation grid (Notion "linked pages") */
.nt-nav { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; margin: 6px 0 14px; }
.nt-nav a.internal-link, .nt-nav .nt-nav-item {
  display: flex; align-items: center; gap: 10px; padding: 10px 12px; text-decoration: none !important;
  border: 1px solid var(--nt-border); border-radius: var(--nt-radius); background: var(--nt-bg-soft); color: var(--nt-text) !important;
}
.nt-nav a.internal-link:hover { background: var(--nt-bg-hover); }
.nt-nav .nt-nav-icon { font-size: 1.25em; }
.nt-nav .nt-nav-text { display: flex; flex-direction: column; line-height: 1.25; }
.nt-nav .nt-nav-desc { font-size: .78em; color: var(--nt-muted); font-weight: 400; }

/* Habit dots */
.nt-dot { display: inline-block; width: 18px; height: 18px; border-radius: 5px; background: var(--nt-gray-bg); vertical-align: middle; }
.nt-dot.on { background: var(--nt-green); }
.nt-habits td, .nt-habits th { text-align: center !important; }
.nt-habits td:first-child, .nt-habits th:first-child { text-align: left !important; }

/* Two-column layout helper */
.nt-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
@media (max-width: 800px) { .nt-cols { grid-template-columns: 1fr; } }
